PAGER_DB_PATH=/data/pager.db

# Required to CREATE a household (joining uses the invite code). Set this on any internet-reachable server.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(16))"
SETUP_KEY=

# seconds without an acknowledgement before the alert is re-sent
ESCALATE_AFTER_S=30
MAX_REALERTS=3

# Optional FCM wake-up path (HTTP v1). See ../docs/FCM_SETUP.md. Leave empty to disable push.
FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/secrets/service-account.json

# Public HTTPS via the bundled Caddy proxy (docker compose --profile tls up -d)
DOMAIN=pager.example.com
# Trust X-Forwarded-For only from your proxy. Behind Caddy in compose use the docker network (e.g. 172.16.0.0/12).
FORWARDED_ALLOW_IPS=127.0.0.1
